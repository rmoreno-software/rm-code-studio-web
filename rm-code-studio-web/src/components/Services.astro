---
const services = [
    {
    hue: "brand",
    title: "Diseño y desarrollo de producto digital",
    desc: "Webs y aplicaciones móviles con diseño UX/UI profesional, centradas en la experiencia de quien las usa. Del concepto al producto en funcionamiento, con un enfoque unificado entre diseño y desarrollo.",
    idealFor: "Ideal si hay que lanzar un producto nuevo o rediseñar uno existente.",
    },
    {
        hue: "cyan",
        title: "Automatización e integraciones",
        desc: "Conexión de herramientas y sistemas para eliminar trabajo manual repetitivo. Automatizaciones de WhatsApp Business, integraciones entre plataformas, flujos que hoy dependen de una persona.",
        idealFor: "Ideal si hay procesos repetitivos o sistemas que deberían estar conectados.",
    },
    {
        hue: "orange",
        title: "Consultoría y auditoría técnica",
        desc: "Análisis de sistemas, infraestructura o procesos digitales, con recomendaciones claras y accionables orientadas al beneficio del negocio.",
        idealFor: "Ideal si hace falta una segunda opinión antes de invertir en un proyecto grande.",
    },
];

const borderColors: Record<string, string> = {
    brand: "border-t-brand",
    cyan: "border-t-cyan-400",
    orange: "border-t-orange-400"
};

const dotColors: Record<string, string> = {
    brand: "bg-brand",
    cyan: "bg-cyan-500",
    orange: "bg-orange-500"
};

const bgColors: Record<string, string> = {
    brand: "bg-brand/15",
    cyan: "bg-cyan-100",
    orange: "bg-orange-100"
};
---

<section id="servicios" class="px-6 py-24 bg-white border-y border-black/10">
    <div class="max-w-5xl mx-auto flex flex-col gap-12">
        <div class="max-w-xl">
            <span class="font-mono text-xs tracking-widest uppercase text-brand font-semibold mb-3 block">
                Servicios
            </span>
            <p class="text-xl font-medium text-ink/90">
                Tres formas de mejorar el producto digital y la operativa de un negocio:
            </p>
        </div>

        <div class="grid md:grid-cols-3 gap-7">
            {services.map((svc) => (
                <div class={`flex flex-col gap-4 p-8 bg-surface border border-black/10 border-t-4 rounded-xl ${borderColors[svc.hue]}`}>
                    <div class={`w-12 h-12 rounded-[10px] flex items-center justify-center ${bgColors[svc.hue]}`}>
                        <div class={`w-[18px] h-[18px] rounded-[5px] ${dotColors[svc.hue]}`}></div>
                    </div>
                    <h3 class="font-display text-lg font-semibold tracking-tight">{svc.title}</h3>
                    <p class="text-sm text-ink/70 flex-1">{svc.desc}</p>
                    <p class="text-xs text-brand font-medium">{svc.idealFor}</p>
                </div>
            ))}
        </div>
    </div>
</section>